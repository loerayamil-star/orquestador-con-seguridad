# Fase 1 (ARQUITECTURA.md §12) — nombres exactos, sin valores.

# Token del bot dado por BotFather.
TELEGRAM_BOT_TOKEN=

# ID numérico del único usuario de Telegram autorizado a usar el bot.
TELEGRAM_ALLOWED_USER_ID=

# Cadena aleatoria propia para validar la cabecera X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Fase 2 (ARQUITECTURA.md §12) — nombres exactos, sin valores.

# Token de integración de Notion, scope mínimo (solo páginas compartidas con la integración).
NOTION_TOKEN=

# API key de Groq, motor temporal del Agente de Conocimiento (ver §1).
GROQ_API_KEY=
